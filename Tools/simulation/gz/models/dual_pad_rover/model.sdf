<?xml version="1.0"?>
<sdf version="1.6">
  <!--
    dual_pad_rover — 2x scaled Ackermann rover with two ArUco landing pads.

    Key dimensions:
      Wheelbase : 1.50 m  (x = ±0.75)
      Track     : 1.10 m  (y = ±0.55)
      Wheel r   : 0.20 m  (z_wheel_link = 0.20)
      Body box  : 2.10 x 0.90 x 0.30  centre z=0.38
      Hull top  : z ≈ 0.62
      ArUco pads: z = 0.625, size 0.32 × 0.32 m
        ID=0  rear  x=-0.55  (UAV1 phase-1 landing)
        ID=1  front x=+0.55  (UAV2 phase-2 landing)
      LiDAR link: x=0.80, z=0.68 relative to base_link
  -->
  <model name="dual_pad_rover">
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <pose>0 0 0.40 0 0 0</pose>
        <mass>45.0</mass>
        <inertia>
          <ixx>4.0</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>18.0</iyy>
          <iyz>0.0</iyz>
          <izz>20.0</izz>
        </inertia>
      </inertial>

      <!-- ── 충돌 박스 ──────────────────────────────────────────── -->
      <collision name="body_collision">
        <pose>0 0 0.38 0 0 0</pose>
        <geometry>
          <box>
            <size>2.10 0.90 0.30</size>
          </box>
        </geometry>
      </collision>

      <!-- ── 시각 요소 ──────────────────────────────────────────── -->
      <visual name="lower_chassis_visual">
        <pose>0 0 0.34 0 0 0</pose>
        <geometry>
          <box>
            <size>2.36 0.98 0.16</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.09 0.10 1</ambient>
          <diffuse>0.08 0.09 0.10 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>

      <visual name="upper_hull_visual">
        <pose>-0.10 0 0.50 0 0 0</pose>
        <geometry>
          <box>
            <size>2.04 0.96 0.24</size>
          </box>
        </geometry>
        <material>
          <ambient>0.72 0.76 0.70 1</ambient>
          <diffuse>0.72 0.76 0.70 1</diffuse>
          <specular>0.25 0.25 0.22 1</specular>
        </material>
      </visual>

      <visual name="front_payload_bay_visual">
        <pose>0.84 0 0.56 0 0 0</pose>
        <geometry>
          <box>
            <size>0.30 0.50 0.20</size>
          </box>
        </geometry>
        <material>
          <ambient>0.84 0.86 0.82 1</ambient>
          <diffuse>0.84 0.86 0.82 1</diffuse>
          <specular>0.3 0.3 0.28 1</specular>
        </material>
      </visual>

      <visual name="front_bumper_visual">
        <pose>1.22 0 0.32 0 0 0</pose>
        <geometry>
          <box>
            <size>0.08 1.10 0.14</size>
          </box>
        </geometry>
        <material>
          <ambient>0.95 0.36 0.08 1</ambient>
          <diffuse>0.95 0.36 0.08 1</diffuse>
          <specular>0.2 0.12 0.08 1</specular>
        </material>
      </visual>

      <visual name="rear_bumper_visual">
        <pose>-1.22 0 0.32 0 0 0</pose>
        <geometry>
          <box>
            <size>0.08 1.10 0.14</size>
          </box>
        </geometry>
        <material>
          <ambient>0.95 0.36 0.08 1</ambient>
          <diffuse>0.95 0.36 0.08 1</diffuse>
          <specular>0.2 0.12 0.08 1</specular>
        </material>
      </visual>

      <visual name="camera_body_visual">
        <pose>1.10 0 0.62 0 0 0</pose>
        <geometry>
          <box>
            <size>0.10 0.20 0.12</size>
          </box>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.035 1</ambient>
          <diffuse>0.03 0.03 0.035 1</diffuse>
          <specular>0.35 0.35 0.35 1</specular>
        </material>
      </visual>

      <visual name="camera_lens_visual">
        <pose>1.18 0 0.62 0 1.5707 0</pose>
        <geometry>
          <cylinder>
            <radius>0.055</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.0 0.025 0.05 1</ambient>
          <diffuse>0.0 0.06 0.12 1</diffuse>
          <specular>0.8 0.9 1.0 1</specular>
        </material>
      </visual>

      <!-- ══ ArUco Landing Pad ID=0 (rear) — UAV1 착륙 ══════════ -->
      <visual name="rear_aruco_pad_id0_visual">
        <pose>-0.55 0 0.627 0 0 0</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.32 0.32</size>
          </plane>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://arucotag/arucotag.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- 패드 배경 (흰색 판) ID=0 -->
      <visual name="rear_pad_bg_visual">
        <pose>-0.55 0 0.623 0 0 0</pose>
        <geometry>
          <box>
            <size>0.38 0.38 0.004</size>
          </box>
        </geometry>
        <material>
          <ambient>0.95 0.95 0.95 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
          <specular>0 0 0 1</specular>
        </material>
      </visual>

      <!-- ══ ArUco Landing Pad ID=1 (front) — UAV2 착륙 ══════════ -->
      <visual name="front_aruco_pad_id1_visual">
        <pose>0.55 0 0.627 0 0 0</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.32 0.32</size>
          </plane>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://dual_pad_rover/aruco_marker_id1.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- 패드 배경 (흰색 판) ID=1 -->
      <visual name="front_pad_bg_visual">
        <pose>0.55 0 0.623 0 0 0</pose>
        <geometry>
          <box>
            <size>0.38 0.38 0.004</size>
          </box>
        </geometry>
        <material>
          <ambient>0.95 0.95 0.95 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
          <specular>0 0 0 1</specular>
        </material>
      </visual>

      <!-- ── 센서들 ─────────────────────────────────────────────── -->
      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>3</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>

      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x><noise type="gaussian"><stddev>0.0001</stddev></noise></x>
          <y><noise type="gaussian"><stddev>0.0001</stddev></noise></y>
          <z><noise type="gaussian"><stddev>0.0001</stddev></noise></z>
        </magnetometer>
      </sensor>

      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0008726646</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0008726646</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0008726646</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.00637</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.00637</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.00686</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>

    <!-- ── LiDAR 링크 ──────────────────────────────────────────── -->
    <link name="lidar_sensor_link">
      <pose relative_to="base_link">0.80 0 0.68 0 0 0</pose>
      <inertial>
        <pose>0 0 0.0435 0 0 0</pose>
        <mass>0.37</mass>
        <inertia>
          <ixx>0.0003443775</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0003443775</iyy>
          <iyz>0</iyz>
          <izz>0.000222</izz>
        </inertia>
      </inertial>
      <collision name="collision_base">
        <pose>0 0 0.0205 0 0 0</pose>
        <geometry>
          <box><size>0.06 0.06 0.041</size></box>
        </geometry>
      </collision>
      <collision name="collision_head">
        <pose>0 0 0.055 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.04</radius><length>0.05</length></cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh><uri>model://lidar_2d_v2/meshes/lidar_2d_v2.dae</uri></mesh>
        </geometry>
      </visual>

      <sensor name="lidar" type="gpu_lidar">
        <gz_frame_id>lidar_sensor_link</gz_frame_id>
        <pose>0 0 0.055 0 0 0</pose>
        <update_rate>20</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>1024</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0.0</min_angle>
              <max_angle>0.0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>30.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.002</stddev>
          </noise>
        </ray>
      </sensor>
    </link>

    <joint name="lidar_sensor_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_sensor_link</child>
    </joint>

    <!-- ── 바퀴 링크 ──────────────────────────────────────────── -->
    <!-- lf = left-front, lb = left-back, rf = right-front, rb = right-back -->
    <!-- x=±0.75 (wheelbase/2), y=±0.55 (track/2), z=0.20 (wheel radius)  -->

    <link name="lf_wheel_link">
      <pose>0.75 0.55 0.20 0 0 0</pose>
      <inertial>
        <pose>0 0 0 1.57079632679 0 0</pose>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.024</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.024</iyy><iyz>0</iyz>
          <izz>0.040</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder><radius>0.20</radius><length>0.15</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu><mu2>1.5</mu2>
              <fdir1>1 0 0</fdir1>
              <slip1>0.0</slip1><slip2>0.0</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="tire_visual">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder><radius>0.20</radius><length>0.15</length></cylinder>
        </geometry>
        <material>
          <ambient>0.015 0.015 0.015 1</ambient>
          <diffuse>0.015 0.015 0.015 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>
      <visual name="hub_visual">
        <pose>0 0.075 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder><radius>0.09</radius><length>0.018</length></cylinder>
        </geometry>
        <material>
          <ambient>0.72 0.72 0.68 1</ambient>
          <diffuse>0.72 0.72 0.68 1</diffuse>
          <specular>0.35 0.35 0.32 1</specular>
        </material>
      </visual>
    </link>

    <link name="lb_wheel_link">
      <pose>-0.75 0.55 0.20 0 0 0</pose>
      <inertial>
        <pose>0 0 0 1.57079632679 0 0</pose>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.024</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.024</iyy><iyz>0</iyz>
          <izz>0.040</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder><radius>0.20</radius><length>0.15</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu><mu2>1.5</mu2>
              <fdir1>1 0 0</fdir1>
              <slip1>0.0</slip1><slip2>0.0</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="tire_visual">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder><radius>0.20</radius><length>0.15</length></cylinder>
        </geometry>
        <material>
          <ambient>0.015 0.015 0.015 1</ambient>
          <diffuse>0.015 0.015 0.015 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>
      <visual name="hub_visual">
        <pose>0 0.075 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder><radius>0.09</radius><length>0.018</length></cylinder>
        </geometry>
        <material>
          <ambient>0.72 0.72 0.68 1</ambient>
          <diffuse>0.72 0.72 0.68 1</diffuse>
          <specular>0.35 0.35 0.32 1</specular>
        </material>
      </visual>
    </link>

    <link name="rf_wheel_link">
      <pose>0.75 -0.55 0.20 0 0 0</pose>
      <inertial>
        <pose>0 0 0 1.57079632679 0 0</pose>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.024</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.024</iyy><iyz>0</iyz>
          <izz>0.040</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder><radius>0.20</radius><length>0.15</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu><mu2>1.5</mu2>
              <fdir1>1 0 0</fdir1>
              <slip1>0.0</slip1><slip2>0.0</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="tire_visual">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder><radius>0.20</radius><length>0.15</length></cylinder>
        </geometry>
        <material>
          <ambient>0.015 0.015 0.015 1</ambient>
          <diffuse>0.015 0.015 0.015 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>
      <visual name="hub_visual">
        <pose>0 -0.075 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder><radius>0.09</radius><length>0.018</length></cylinder>
        </geometry>
        <material>
          <ambient>0.72 0.72 0.68 1</ambient>
          <diffuse>0.72 0.72 0.68 1</diffuse>
          <specular>0.35 0.35 0.32 1</specular>
        </material>
      </visual>
    </link>

    <link name="rb_wheel_link">
      <pose>-0.75 -0.55 0.20 0 0 0</pose>
      <inertial>
        <pose>0 0 0 1.57079632679 0 0</pose>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.024</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.024</iyy><iyz>0</iyz>
          <izz>0.040</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder><radius>0.20</radius><length>0.15</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu><mu2>1.5</mu2>
              <fdir1>1 0 0</fdir1>
              <slip1>0.0</slip1><slip2>0.0</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="tire_visual">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder><radius>0.20</radius><length>0.15</length></cylinder>
        </geometry>
        <material>
          <ambient>0.015 0.015 0.015 1</ambient>
          <diffuse>0.015 0.015 0.015 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>
      <visual name="hub_visual">
        <pose>0 -0.075 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder><radius>0.09</radius><length>0.018</length></cylinder>
        </geometry>
        <material>
          <ambient>0.72 0.72 0.68 1</ambient>
          <diffuse>0.72 0.72 0.68 1</diffuse>
          <specular>0.35 0.35 0.32 1</specular>
        </material>
      </visual>
    </link>

    <!-- ── 스티어링 링크 ──────────────────────────────────────── -->
    <link name="lf_steering_link">
      <pose relative_to="lf_wheel_link">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.20</mass>
        <inertia>
          <ixx>0.00012</ixx><iyy>0.00012</iyy><izz>0.00012</izz>
        </inertia>
      </inertial>
    </link>

    <link name="rf_steering_link">
      <pose relative_to="rf_wheel_link">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.20</mass>
        <inertia>
          <ixx>0.00012</ixx><iyy>0.00012</iyy><izz>0.00012</izz>
        </inertia>
      </inertial>
    </link>

    <!-- ── 조인트 ─────────────────────────────────────────────── -->
    <joint name="lf_steering_joint" type="revolute">
      <parent>base_link</parent>
      <child>lf_steering_link</child>
      <pose relative_to="lf_steering_link">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-0.5236</lower><upper>0.5236</upper></limit>
        <dynamics><damping>0.8</damping><friction>0.02</friction></dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <joint name="rf_steering_joint" type="revolute">
      <parent>base_link</parent>
      <child>rf_steering_link</child>
      <pose relative_to="rf_steering_link">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-0.5236</lower><upper>0.5236</upper></limit>
        <dynamics><damping>0.8</damping><friction>0.02</friction></dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <joint name="front_left_wheel_joint" type="revolute">
      <child>lf_wheel_link</child>
      <parent>lf_steering_link</parent>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <joint name="rear_left_wheel_joint" type="revolute">
      <child>lb_wheel_link</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <joint name="front_right_wheel_joint" type="revolute">
      <child>rf_wheel_link</child>
      <parent>rf_steering_link</parent>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <joint name="rear_right_wheel_joint" type="revolute">
      <child>rb_wheel_link</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <static>0</static>

    <!-- ── 플러그인 ─────────────────────────────────────────────── -->
    <plugin filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
      <joint_name>rear_left_wheel_joint</joint_name>
      <sub_topic>command/motor_speed</sub_topic>
      <control_type>velocity</control_type>
      <use_actuator_msg>true</use_actuator_msg>
      <actuator_number>0</actuator_number>
      <p_gain>15.0</p_gain>
    </plugin>

    <plugin filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
      <joint_name>rear_right_wheel_joint</joint_name>
      <sub_topic>command/motor_speed</sub_topic>
      <control_type>velocity</control_type>
      <use_actuator_msg>true</use_actuator_msg>
      <actuator_number>0</actuator_number>
      <p_gain>15.0</p_gain>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>lf_steering_joint</joint_name>
      <sub_topic>servo_0</sub_topic>
      <p_gain>30</p_gain>
      <i_gain>0</i_gain>
      <d_gain>1.0</d_gain>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>rf_steering_joint</joint_name>
      <sub_topic>servo_0</sub_topic>
      <p_gain>30</p_gain>
      <i_gain>0</i_gain>
      <d_gain>1.0</d_gain>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
      <joint_name>lf_steering_joint</joint_name>
      <joint_name>rf_steering_joint</joint_name>
    </plugin>
  </model>
</sdf>
