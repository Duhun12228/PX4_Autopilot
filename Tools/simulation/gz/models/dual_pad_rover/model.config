<?xml version="1.0"?>
<model>
  <name>dual_pad_rover</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <author>
    <name>duhun</name>
    <email>kdh1228@inha.edu</email>
  </author>
  <description>
    Dual-pad Ackermann rover for two-UAV recovery system.
    Scaled 2x from explorer_ackermann_rover.
    ArUco ID=0 on rear pad (UAV1 landing), ID=1 on front pad (UAV2 landing).
    Wheelbase: 1.50m, Track: 1.10m, Wheel radius: 0.20m
  </description>
</model>
