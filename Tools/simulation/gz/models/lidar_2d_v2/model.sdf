<?xml version="1.0"?>
<sdf version="1.6">
  <model name="lidar_3d_v1">

    <link name="link">
      <pose>0 0 0 0 0 0</pose>

      <!-- ---------------- Inertial ---------------- -->
      <inertial>
        <pose>0 0 0.0435 0 0 0</pose>
        <mass>0.37</mass>
        <inertia>
          <ixx>0.0003443775</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0003443775</iyy>
          <iyz>0</iyz>
          <izz>0.000222</izz>
        </inertia>
      </inertial>

      <!-- ---------------- Collision ---------------- -->
      <collision name="collision_base">
        <pose>0 0 0.0205 0 0 0</pose>
        <geometry>
          <box>
            <size>0.06 0.06 0.041</size>
          </box>
        </geometry>
      </collision>

      <collision name="collision_mid">
        <pose>0 0 0.055 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.025</radius>
            <length>0.028</length>
          </cylinder>
        </geometry>
      </collision>

      <collision name="collision_top">
        <pose>0 0 0.078 0 0 0</pose>
        <geometry>
          <box>
            <size>0.056 0.056 0.018</size>
          </box>
        </geometry>
      </collision>

      <!-- ---------------- Visual ---------------- -->
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://lidar_2d_v2/meshes/lidar_2d_v2.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <!-- ================= 3D LiDAR Sensor ================= -->
      <sensor name="lidar_3d" type="gpu_lidar">
        <gz_frame_id>link</gz_frame_id>
        <pose>0 0 0.055 0 0 0</pose>

        <ray>
          <scan>
            <!-- -------- Horizontal Scan -------- -->
            <horizontal>
              <samples>1024</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle> 3.14159265</max_angle>
            </horizontal>

            <!-- -------- Vertical Scan (3D 핵심) -------- -->
            <vertical>
              <samples>16</samples>
              <min_angle>-0.261799</min_angle> <!-- -15 deg -->
              <max_angle> 0.261799</max_angle> <!-- +15 deg -->
            </vertical>
          </scan>

          <range>
            <min>0.1</min>
            <max>30.0</max>
            <resolution>0.01</resolution>
          </range>

          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.002</stddev>
          </noise>
        </ray>

        <update_rate>20</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>

    </link>
  </model>
</sdf>

